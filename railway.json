{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "backend/Dockerfile"
  },
  "deploy": {
    "startCommand": "python manage.py migrate && daphne -b 0.0.0.0 -p ${PORT:-8000} config.asgi:application",
    "restartPolicyType": "ON_FAILURE"
  }
}
